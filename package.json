{
  "name": "@pletopay/node",
  "version": "1.0.0",
  "description": "Official Node.js SDK for the Pletopay API: bank-transfer payments, virtual accounts, transfers, checkout and signed webhooks for Nigeria.",
  "license": "MIT",
  "author": "Pletopay",
  "homepage": "https://docs.pletopay.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/evidenze/pletopay-sdk-node.git"
  },
  "bugs": {
    "url": "https://github.com/evidenze/pletopay-sdk-node/issues"
  },
  "keywords": [
    "pletopay",
    "payments",
    "nigeria",
    "bank transfer",
    "virtual account",
    "checkout",
    "webhooks",
    "sdk",
    "api"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "clean": "rm -rf dist",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"{src,test,scripts,examples}/**/*.{ts,mjs,js}\" \"*.{json,md}\"",
    "format:check": "prettier --check \"{src,test,scripts,examples}/**/*.{ts,mjs,js}\" \"*.{json,md}\"",
    "test": "vitest run --project unit",
    "test:watch": "vitest --project unit",
    "test:live": "vitest run --project live",
    "spec:sync": "node scripts/sync-spec.mjs",
    "spec:check": "node scripts/sync-spec.mjs --check",
    "generate": "node scripts/generate.mjs",
    "generate:check": "node scripts/generate.mjs --check",
    "generate:docs": "node scripts/generate-docs.mjs",
    "docs:check": "node scripts/generate-docs.mjs --check",
    "check:brand": "node scripts/check-brand.mjs",
    "check:package": "pnpm build && publint && attw --pack . --profile node16",
    "verify": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm generate:check && pnpm docs:check && pnpm check:brand && pnpm test && pnpm check:package",
    "prepublishOnly": "pnpm verify"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^9.39.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.3.0",
    "openapi-typescript": "^7.13.0",
    "prettier": "^3.9.9",
    "publint": "^0.3.25",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5",
    "yaml": "^2.8.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
